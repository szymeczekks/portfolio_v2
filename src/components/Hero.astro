---
import Link from '../components/Link.astro';
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="min-h-screen flex items-center font-text pt-22 md:pt-20 px-4 md:px-10">
    <div class="max-w-portfolio w-full mx-auto flex flex-col md:flex-row justify-between md:items-end gap-10">
        <div class="flex flex-col gap-5">
            <h2 class="text-xs text-accent uppercase tracking-[.3em]">Full Stack Developer</h2>
            <h1 class="text-header text-5xl md:text-8xl font-header font-light">
                Szymon <br>
                <span class="font-bold">
                    Mińko
                </span>
            </h1>
            <h2 class="max-w-lg text-text text-xs md:text-base">
                {t('hero.description')}
            </h2>
            <div class="flex flex-wrap gap-5 items-center">
                <Link href='#projects' text={t('hero.see_projects')} variant='border'/>
                <Link href='#contact' text={t('hero.write_to_me')} variant='inline'/>
            </div>
        </div>
        <div class="flex flex-col items-center gap-2">
            <span class="text-text uppercase [writing-mode:vertical-rl] text-xs tracking-[0.3em]">Scroll</span>
            <span class="w-px h-10 bg-size-[100%_200%] bg-linear-to-b from-transparent via-header to-transparent bg-repeat-y animate-scroll bg-position-[0%_0%]"></span>
        </div>
    </div>
</section>
