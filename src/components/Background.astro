<style></style>

<canvas id='background' class='block fixed t-0 -z-1'></canvas>

<script>
	interface Star {
		x: number;
		y: number;
		radius: number;
		depth: number;
		alpha: number;
		phase: number;
		pulses: boolean;
		pulseSpeed: number;
		shadow: boolean;
	}

	interface ShootingStar {
		birthTime: number;
		maxLifeTime: number;
		lifeTime: number;
		speed: number;
		radius: number;
		lineLength: number;
		direction: Point;
		position: Point;
	}

	interface CanvasSizes {
		logicWidth: number;
		logicHeight: number;
		physicWidth: number;
		physicHeight: number;
	}

	interface Viewport {
		width: number;
		height: number;
		marginLeft: number;
		marginRight: number;
		marginTop: number;
		marginBottom: number;
	}

	interface Point {
		x: number;
		y: number;
	}

	const SCROLL_FACTOR = 0.16;
	const MAX_STAR_RADIUS = 2.6;
	const SMOOTH_FACTOR = 0.1;
	const MOUSE_SMOOTH_STRENGTH = 50;
	const VIEWPORT_MARGIN = 0.1;
	const MIN_BIRTH_TIME = 5;
	const MAX_BIRTH_TIME = 25;
	const MIN_SHOOTING_STAR_SPEED = 500;
	const MAX_SHOOTING_STAR_SPEED = 800;
	const canvas = document.querySelector<HTMLCanvasElement>('#background');

	function init() {
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const offscreenCanvas: HTMLCanvasElement = document.createElement('canvas');
		const offscreenCtx: CanvasRenderingContext2D = offscreenCanvas.getContext('2d');
		const dpr = Math.min(window.devicePixelRatio || 1, 2);

		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		offscreenCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

		let viewport: Viewport = getViewportData();
		let canvasSizes: CanvasSizes = getCanvasSizes(viewport, dpr);
		let stars = createStars(viewport);

		const mouseTarget: Point = { x: 0, y: 0 };
		const mouseSmooth: Point = { x: 0, y: 0 };
		const scrollTarget: Point = { x: 0, y: window.scrollY };
		let scrollSmooth: Point = { x: 0, y: 0 };

		setCanvasSizes(canvas, canvasSizes);
		setCanvasSizes(offscreenCanvas, canvasSizes);
		drawCosmicDust(viewport, offscreenCtx);

		window.addEventListener('mousemove', (e) => {
			mouseTarget.x = (e.clientX / viewport.width) * 2 - 1;
			mouseTarget.y = (e.clientY / viewport.height) * 2 - 1;
		});

		window.addEventListener('scroll', () => {
			scrollTarget.y = window.scrollY;
		});

		window.addEventListener('resize', () => {
            /* debounce */
			viewport = getViewportData();
			setCanvasSizes(canvas, canvasSizes);
			setCanvasSizes(offscreenCanvas, canvasSizes);
			drawCosmicDust(viewport, offscreenCtx);
			stars.length = 0;
			stars.push(...createStars(viewport));
		});

		const shootingStar: ShootingStar = {
			birthTime: getBirthTime(performance.now() / 1000),
			lifeTime: 0,
			maxLifeTime: 1,
			speed: 600,
			radius: 3,
			lineLength: 200,
			direction: { x: 0, y: 0 },
			position: { x: 0, y: 0 },
		};

		window.requestAnimationFrame(() => draw(viewport, ctx, stars, shootingStar, mouseTarget, mouseSmooth, scrollTarget, scrollSmooth, offscreenCanvas));
	}

	function getViewportData(): Viewport {
		return {
			height: window.innerHeight,
			width: innerWidth,
			marginLeft: innerWidth * VIEWPORT_MARGIN,
			marginRight: innerWidth * (1 - VIEWPORT_MARGIN),
			marginTop: window.innerHeight * VIEWPORT_MARGIN,
			marginBottom: window.innerHeight * (1 - VIEWPORT_MARGIN),
		};
	}

	function getCanvasSizes(viewport: Viewport, dpr: number): CanvasSizes {
		const logicWidth = viewport.width;
		const logicHeight = viewport.height;
		const physicWidth = logicWidth * dpr;
		const physicHeight = logicHeight * dpr;

		return {
			logicWidth,
			logicHeight,
			physicWidth,
			physicHeight,
		};
	}

	function setCanvasSizes(ctx: HTMLCanvasElement, sizes: CanvasSizes) {
		ctx.width = sizes.physicWidth;
		ctx.height = sizes.physicHeight;
		ctx.style.height = `${sizes.logicHeight}px`;
		ctx.style.width = `${sizes.logicWidth}px`;
	}

	function draw(viewport: Viewport, ctx: CanvasRenderingContext2D, stars: Star[], shootingStar: ShootingStar, mouseTarget: Point, mouseSmooth: Point, scrollTarget: Point, scrollSmooth: Point, offscreenCanvas: HTMLCanvasElement) {
		mouseSmooth.x += (mouseTarget.x - mouseSmooth.x) * SMOOTH_FACTOR;
		mouseSmooth.y += (mouseTarget.y - mouseSmooth.y) * SMOOTH_FACTOR;
		scrollSmooth.y += (scrollTarget.y - scrollSmooth.y) * SMOOTH_FACTOR;

		ctx.clearRect(0, 0, viewport.width, viewport.height);
		ctx.globalAlpha = 0.2;
		ctx.drawImage(offscreenCanvas, 0, -(scrollSmooth.y * SCROLL_FACTOR), viewport.width, viewport.height);
		ctx.drawImage(offscreenCanvas, 0, -(scrollSmooth.y * SCROLL_FACTOR) + viewport.height, viewport.width, viewport.height);
		ctx.globalAlpha = 1;

		for (const star of stars) {
			const starX = star.x + mouseSmooth.x * star.depth * MOUSE_SMOOTH_STRENGTH;
			const starY = (((star.y - scrollSmooth.y * SCROLL_FACTOR + mouseSmooth.y * star.depth * MOUSE_SMOOTH_STRENGTH) % viewport.height) + viewport.height) % viewport.height;
			const alpha = star.pulses ? getPulsingAlpha(star.pulseSpeed, star.phase, star.alpha) : star.alpha;

			ctx.beginPath();
			ctx.arc(starX, starY, star.radius, Math.PI * 2, 0);
			ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
			ctx.fill();

			if (star.shadow) {
				const g = ctx.createRadialGradient(starX, starY, 0, starX, starY, star.radius * 5.5);
				g.addColorStop(0, 'rgba(255,255,255,' + alpha * 0.5 + ')');
				g.addColorStop(1, 'rgba(255,255,255,0)');
				ctx.fillStyle = g;
				ctx.beginPath();
				ctx.arc(starX, starY, star.radius * 5.5, Math.PI * 2, 0);
				ctx.fill();
			}
		}

		if (performance.now() / 1000 > shootingStar.birthTime) {
			drawShootingStar(ctx, viewport, shootingStar);
		}

		window.requestAnimationFrame(() => draw(viewport, ctx, stars, shootingStar, mouseTarget, mouseSmooth, scrollTarget, scrollSmooth, offscreenCanvas));
	}

	function drawCosmicDust(viewport: Viewport, ctx: CanvasRenderingContext2D) {
		const perpUnit = perpendicularUnit(viewport);
		const scatterRadius = viewport.height * 0.25;
		let alpha = 0.1;

		ctx.clearRect(0, 0, viewport.width, viewport.height);

		for (let i = 0; i < 320; i++) {
			const radius = 60 + Math.random() * 80;
			const point = diagonalPoint(viewport, perpUnit, scatterRadius);
			const accent = isDustInAccent();
			const color = accent ? '194, 163, 122' : '255, 255, 255';
			const localAlpha = accent ? 0.3 : alpha;

			if (i < 300) {
				drawCosmicBlob(point.x, point.y, radius, localAlpha, color, ctx);
			} else {
				ctx.globalCompositeOperation = 'destination-out';
				alpha = 0.2;
				drawCosmicBlob(point.x, point.y, radius, localAlpha, color, ctx);
			}

			if (point.y + radius > viewport.height) {
				drawCosmicBlob(point.x, point.y - viewport.height, radius, localAlpha, color, ctx);
			}

			if (point.y - radius < 0) {
				drawCosmicBlob(point.x, point.y + viewport.height, radius, localAlpha, color, ctx);
			}
		}
	}

	function drawCosmicBlob(x: number, y: number, radius: number, alpha: number, color: string, ctx: CanvasRenderingContext2D) {
		const g = ctx.createRadialGradient(x, y, 0, x, y, radius);
		g.addColorStop(0, `rgba(${color}, ${alpha})`);
		g.addColorStop(1, `rgba(${color},0)`);
		ctx.fillStyle = g;
		ctx.beginPath();
		ctx.arc(x, y, radius, Math.PI * 2, 0);
		ctx.fill();
	}

	function createStars(viewport: Viewport) {
		const stars: Star[] = [];
		const perpUnit = perpendicularUnit(viewport);
		const scatterRadius = viewport.height * 0.17;
		for (let i = 0; i < 1300; i++) {
			const r = getStarRadius();
			const point = isDiagonal() ? diagonalPoint(viewport, perpUnit, scatterRadius) : randomPoint(viewport);
			const depth = r / MAX_STAR_RADIUS;
			const alpha = getStarAlpha(depth);

			stars.push({
				x: point.x,
				y: point.y,
				radius: r,
				alpha: alpha,
				depth: depth,
				pulses: depth > 0.3,
				phase: Math.random() * 100,
				pulseSpeed: 2,
				shadow: depth > 0.9,
			});
		}

		return stars;
	}

	function getStarRadius(): number {
		const t = Math.random() ** 13;
		return 0.3 + t * MAX_STAR_RADIUS;
	}

	function getStarAlpha(depth: number): number {
		const max = 1;
		const min = 0.5;
		return min + (1 - depth) * (max - min);
	}

	function getPulsingAlpha(speed: number, phase: number, maxAlpha: number): number {
		const pulseModulation = (Math.sin((performance.now() / 1000) * speed + phase) + 1) / 2;
		return 0.1 + pulseModulation * (maxAlpha - 0.1);
	}

	function isDiagonal(): boolean {
		return Math.random() < 0.6;
	}

	function isDustInAccent(): boolean {
		return Math.random() < 0.05;
	}

	function diagonalPoint(viewport: Viewport, perpUnit: Point, scatterRadius: number): Point {
		const g = gaussianOffset();
		const t = Math.random() * 1;
		const x = 0 + t * viewport.width;
		const y = viewport.height + t * -viewport.height;
		return {
			x: x + g * scatterRadius * perpUnit.x,
			y: y + g * scatterRadius * perpUnit.y,
		};
	}

	function randomPoint(viewport: Viewport): Point {
		return {
			x: Math.random() * viewport.width,
			y: Math.random() * viewport.height,
		};
	}

	function perpendicularUnit(viewport: Viewport): Point {
		const perp = {
			x: viewport.height,
			y: viewport.width,
		};

		const length = Math.sqrt(perp.x ** 1.95 + perp.y ** 1.95);
		return {
			x: perp.x / length,
			y: perp.y / length,
		};
	}

	function gaussianOffset(): number {
		return (Math.random() + Math.random() + Math.random() + Math.random() - 2) / 2;
	}

	function drawShootingStar(ctx: CanvasRenderingContext2D, viewport: Viewport, shootingStar: ShootingStar) {
		if (!shootingStar.lifeTime) {
			randomShootingStar(shootingStar, viewport);
		}
		const now = performance.now() / 1000;

		shootingStar.lifeTime = now - shootingStar.birthTime;

		if (shootingStar.lifeTime >= shootingStar.maxLifeTime) {
			shootingStar.lifeTime = 0;
			shootingStar.birthTime = getBirthTime(now);
			return;
		}

		const starX = shootingStar.position.x + shootingStar.speed * shootingStar.lifeTime * shootingStar.direction.x;
		const starY = shootingStar.position.y + shootingStar.speed * shootingStar.lifeTime * shootingStar.direction.y;
		const alpha = getShootingStarFade(shootingStar.lifeTime / shootingStar.maxLifeTime);

		ctx.beginPath();
		ctx.arc(starX, starY, shootingStar.radius, Math.PI * 2, 0);
		ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
		ctx.fill();

		const g = ctx.createRadialGradient(starX, starY, 0, starX, starY, shootingStar.radius * 5.5);
		g.addColorStop(0, 'rgba(255,255,255,' + alpha * 0.5 + ')');
		g.addColorStop(1, 'rgba(255,255,255,0)');
		ctx.fillStyle = g;
		ctx.beginPath();
		ctx.arc(starX, starY, shootingStar.radius * 5.5, Math.PI * 2, 0);
		ctx.fill();

		const lineLength = Math.min(shootingStar.speed * shootingStar.lifeTime, shootingStar.lineLength);
		const lineEndX = starX - lineLength * shootingStar.direction.x;
		const lineEndY = starY - lineLength * shootingStar.direction.y;
		const lineGradient = ctx.createLinearGradient(starX, starY, lineEndX, lineEndY);
		lineGradient.addColorStop(0, `rgba(255, 255, 255, ${alpha})`);
		lineGradient.addColorStop(1, `rgba(255, 255, 255, 0)`);

		ctx.strokeStyle = lineGradient;
		ctx.lineWidth = shootingStar.radius / 2;
		ctx.beginPath();
		ctx.moveTo(starX, starY);
		ctx.lineTo(lineEndX, lineEndY);
		ctx.stroke();
	}

	function randomShootingStar(shootingStar: ShootingStar, viewport: Viewport) {
		const randomX = viewport.marginLeft + Math.random() * (viewport.marginRight - viewport.marginLeft);
		const randomY = viewport.marginTop + Math.random() * (viewport.marginBottom - viewport.marginTop);
		const randomAngle = Math.random() * 2 * Math.PI;
		const vx = 1 * Math.cos(randomAngle);
		const vy = 1 * Math.sin(randomAngle);
		const speed = MIN_SHOOTING_STAR_SPEED + Math.random() * (MAX_SHOOTING_STAR_SPEED - MIN_SHOOTING_STAR_SPEED);

		shootingStar.position.x = randomX;
		shootingStar.position.y = randomY;
		shootingStar.direction.x = vx;
		shootingStar.direction.y = vy;
		shootingStar.speed = speed;
	}

	function getShootingStarFade(t: number): number {
		return Math.sin(Math.PI * t);
	}

	function getBirthTime(from: number): number {
		return from + (MIN_BIRTH_TIME + Math.random() * (MAX_BIRTH_TIME - MIN_BIRTH_TIME));
	}

	init();
</script>
