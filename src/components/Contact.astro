    ---
    import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
    import Button from './Button.astro';
    import Link from './Link.astro';

    export interface ContactData {
        email: string,
        name: string,
        message: string,
        consent: string,
    };

    const lang = getLangFromUrl(Astro.url);
    const t = useTranslations(lang);
    ---

    <section class='px-4 md:px-10 py-10'>
        <div class='max-w-portfolio mx-auto'>
            <div id="contact" class='flex flex-wrap md:items-start flex-col md:flex-row gap-10 mb-10 mt-10 md:mt-40 scroll-m-25'>
                <div class="flex-1 flex flex-col gap-4">
                    <p class='text-xs uppercase tracking-[.3em] text-accent flex-1'>04 - {t('contact.contact')}</p>
                    <h2 class='text-4xl text-header font-light font-header flex-2'>{t('contact.header')}</h2>
                    <p class='text font text-text font-header flex-1'>{t('contact.subheader')}</p>
                    <Link
                        href='mailto:contact@szymonminko.com'
                        variant='inline-header'
                        text='contact@szymonminko.com'
                    />
                </div>
                <div class="flex-2">
                    <form id="form" class="flex flex-col gap-8" novalidate>
                        <div class="flex flex-col gap-4">
                            <label class="uppercase tracking-[.3em] text-xs" for="name">{t('contact.name_label')}<sup>*</sup></label>
                            <input
                                data-cursor="link"
                                class="border-b border-header-dim py-2 outline-none focus:border-accent text-header font-header aria-invalid:border-error user-valid:border-success"
                                required
                                type="text"
                                name="name"
                                id="name"
                                placeholder={t('contact.name_placeholder')}
                                autocomplete="name"
                                aria-describedby="error_name"
                            >
                            <p role="alert" id="error_name" class="text-xs text-error"></p>
                        </div>
                        <div class="flex flex-col gap-4">
                            <label class="uppercase tracking-[.3em] text-xs" for="email">{t('contact.email_label')}<sup>*</sup></label>
                            <input
                                data-cursor="link"
                                class="border-b border-header-dim py-2 outline-none focus:border-accent text-header font-header aria-invalid:border-error user-valid:border-success"
                                required
                                type="email"
                                name="email"
                                id="email"
                                placeholder={t('contact.email_placeholder')}
                                autocomplete="email"
                                aria-describedby="error_email"
                            >
                            <p role="alert" id="error_email" class="text-xs text-error"></p>
                        </div>
                        <div class="flex flex-col gap-4">
                            <label class="uppercase tracking-[.3em] text-xs" for="message">{t('contact.message_label')}<sup>*</sup></label>
                            <textarea 
                                data-cursor="link"
                                class="border-b border-header-dim py-2 outline-none focus:border-accent text-header font-header aria-invalid:border-error user-valid:border-success" 
                                required
                                name="message" 
                                id="message"
                                rows="5"
                                placeholder={t('contact.message_placeholder')}
                                aria-describedby="error_message"
                            ></textarea>
                            <p role="alert" id="error_message" class="text-xs text-error"></p>
                        </div>
                        <label for="consent" class="flex gap-5 items-start" data-cursor="link">
                            <input
                                type="checkbox"
                                name="consent"
                                id="consent"
                                class="hidden peer"
                                required
                                aria-describedby="error_consent"
                            >
                            <div class="border border-text w-11 flex items-center justify-center aspect-square rounded-md peer-checked:border-accent *:hidden peer-checked:*:block peer-aria-invalid:border-error">
                                <Icon name='check' size="23"/>
                            </div>
                            <p>
                                {t('contact.consent_1')} <Link href='/privacy-policy' text={t('contact.privacy_policy')} variant="inline" /> {t('contact.consent_2')}<sup>*</sup>
                            </p>
                        </label>
                        <p role="alert" id="error_consent" class="text-xs text-error"></p>
                        <p id="globalMessage" class="text-text font-header"></p>
                        <div>
                            <Button
                                variant='border'
                                text={t('contact.submit')}
                                type='submit'
                                icon={{
                                    name: 'send',
                                    position: 'right'
                                }}
                                id='submit'
                            />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <script>
        import { getLangFromUrl, useTranslations } from '../i18n/utils';
        import type { InputError } from "../pages/api/contact";
        import type { ContactData } from './Contact.astro';
        const lang = getLangFromUrl(new URL(window.location.href));
        const t = useTranslations(lang);

        interface Inputs {
            name: Input,
            email: Input,
            message: Input,
            consent: Input,
        };

        class Input {
            readonly input: HTMLInputElement;
            readonly errorMessage: HTMLElement | null;
            readonly validityKeys: (keyof ValidityState)[] = [
                'valueMissing',
                'patternMismatch',
                'typeMismatch',
                'badInput',
                'customError',
                'rangeOverflow',
                'rangeUnderflow',
                'stepMismatch',
                'tooLong',
                'tooShort',
            ];
            hasFirstBlur: boolean;

            constructor(input: HTMLInputElement) {
                this.input = input;

                this.errorMessage = document.querySelector(`#error_${this.input.id}`);
                this.hasFirstBlur = false;

                this.init();
            }

            init() {
                this.input.addEventListener('blur', () => {
                    if (!this.hasFirstBlur) this.hasFirstBlur = true;
                    this.input.checkValidity();
                    this.validate(this.input.validity);
                });

                this.input.addEventListener('input', () => {
                    if (!this.hasFirstBlur) return;
                    this.validate(this.input.validity);
                });
            }

            validate(validityState: ValidityState) {
                if (validityState.valid) {
                    this.input.removeAttribute('aria-invalid');
                }
                if (validityState.valid && this.errorMessage) {
                    this.errorMessage.textContent = '';
                }

                const invalidKeys: (keyof ValidityState)[] = [];

                for (const validityKey of this.validityKeys) {
                    if (validityState[validityKey]) {
                        invalidKeys.push(validityKey);
                    }
                }

                if (!invalidKeys.length) return;

                this.setError(t(`contact.errors.${invalidKeys[0]}`));
            }

            setError(message: string) {
                this.input.setAttribute('aria-invalid', 'true');

                if (this.errorMessage) {
                    this.errorMessage.textContent = message || '';
                }
            }

            isValid() {
                return this.input.validity.valid;
            }
        }

        const name = document.querySelector<HTMLInputElement>('#name');
        const email = document.querySelector<HTMLInputElement>('#email');
        const message = document.querySelector<HTMLInputElement>('#message');
        const consent = document.querySelector<HTMLInputElement>('#consent');
        const form: HTMLFormElement | null = document.querySelector('#form');
        const globalMessage: HTMLElement | null = document.querySelector('#globalMessage');
        if (name && email && message && consent && form && globalMessage) {
            const inputs: Inputs = {
                name: new Input(name),
                email: new Input(email),
                message: new Input(message),
                consent: new Input(consent),
            };
        
            form?.addEventListener('submit', e => onSubmit(e, form, inputs, globalMessage));
        }

        async function onSubmit(e: Event, form: HTMLFormElement, inputs: Inputs, globalMessage: HTMLElement) {
            e.preventDefault();
            globalMessage.textContent = '';
            let firstInvalid = false;
            const data: ContactData | any = {};
            for (const input of Object.values(inputs)) {
                input.validate(input.input.validity);
                if (!input.isValid() && !firstInvalid) {
                    input.input.focus();
                    firstInvalid = true;
                }

                if (input.input.type === 'checkbox') {
                    data[input.input.name] = input.input.checked;
                } else {
                    data[input.input.name] = input.input.value;
                }
            }
            
            if (firstInvalid) return;

            form.setAttribute('aria-busy', 'true');
            try {
                const res = await fetch('api/contact', {
                    method: 'POST',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });
                
                const responseData = await res.json();
                
                if (!responseData.ok && responseData.errors?.length) {
                    const errors: InputError[] = responseData.errors;
                    for (const error of errors) {
                        const input = inputs[error.name];
                        input.setError(error.message.pl);
                        if (!firstInvalid) {
                            firstInvalid = true;
                            input.input.focus();
                        }
                    }
                    return;
                }

                if (!responseData.ok) {
                    globalMessage.textContent = responseData.message.pl;
                    return;
                }

                if (!res.ok) throw new Error('Wystąpił nieoczekiwany błąd podczas przesyłania sygnału');

                globalMessage.textContent = responseData.message.pl;
                form.reset();
            } catch (error) {
                globalMessage.textContent = 'Wystąpił nieoczekiwany błąd podczas przesyłania sygnału';
                console.error(error);
            } finally {
                form.removeAttribute('aria-busy');
            }
        }
        
    </script>