---
import { Icon } from 'astro-icon/components';

interface Props {
    href: string,
    text: string,
    variant: 'border' | 'inline' | 'inline-header',
    classes?: string[],
    textSize?: string,
    icon?: {
        name: string,
        position: 'right' | 'left',
    }
}

const {
    text,
    href,
    variant,
    classes = [],
    icon,
    textSize = 'text-xs',
    ...rest
} = Astro.props as Props;

const commonStyles = ['cursor-pointer', 'uppercase', 'gap-2', 'max-w-fit', 'tracking-[.1em]', textSize];
const styles = {
    'border' : [
        'border', 'px-6', 'py-3', 'rounded-full', 'border-header-dim', 'text-header', 'flex',
        'hover:border-accent', 'hover:shadow-[0_0_20px]', 'hover:shadow-accent-dim',
        'transition-all'
    ],
    'inline' : ['text-text', 'py-1', 'inline-flex'],
    'inline-header' : ['text-header', 'py-1', 'inline-flex'],
};
const cursor: 'link' | 'cta' = variant === 'border' ? 'cta' : 'link';

---

<a href={href} data-cursor={cursor} class:list={[...commonStyles, ...styles[variant], ...classes]} {...rest}>
    {icon && icon.position === 'left' && (
        <Icon name={icon.name} size="15"/>
    )}

    <span>{text}</span>

    {icon && icon.position === 'right' && (
        <Icon name={icon.name} size="15"/>
    )}
</a>