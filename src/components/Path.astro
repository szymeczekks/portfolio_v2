---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { milestones } from "../data/milestones";

import Milestone from "./Milestone.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<section class="px-4 md:px-10 py-10">
    <div class="max-w-portfolio mx-auto">
        <div id="path" class="flex flex-wrap md:items-end flex-col md:flex-row gap-4 mb-10 mt-40 scroll-m-25">
            <p class="text-xs uppercase tracking-[.3em] text-accent-dim flex-1">02 - {t('path.path')}</p>
            <h2 class="text-4xl text-header font-light font-header flex-2">{t('path.header')}</h2>
        </div>
        <div class="flex flex-col gap-5">
            {milestones.map(milestone => <Milestone {...milestone} />)}
        </div>
    </div>
</section>